---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TOOL_LABEL, TOOL_TEXT, slugOf, volLabel } from '../../lib/site';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  return issues.map((issue) => ({
    params: { tool: issue.data.tool, slug: slugOf(issue.id, issue.data.tool) },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const { Content } = await render(issue);
const { tool, vol, year, title, description } = issue.data;
---
<Base title={title} description={description}>
  <p class="text-xs tracking-widest text-stone-500">
    <span class={`font-semibold ${TOOL_TEXT[tool]}`}>{TOOL_LABEL[tool]}</span> · {volLabel(vol, year)}
  </p>
  <h1 class="mt-2 text-3xl font-bold leading-snug">{title}</h1>
  <p class="mt-3 text-lg text-stone-600">{description}</p>
  <article class="prose prose-stone mt-10 max-w-none prose-headings:font-bold prose-pre:bg-stone-800 prose-pre:whitespace-pre-wrap prose-table:text-sm prose-code:before:content-none prose-code:after:content-none">
    <Content />
  </article>
</Base>

<script>
  // Copy button on every instruction example so faculty can paste it straight into a project.
  document.querySelectorAll<HTMLPreElement>('article pre').forEach((pre) => {
    if (pre.closest('.not-prose')) return;
    pre.style.position = 'relative';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = '복사';
    btn.className = 'absolute right-3 top-3 rounded-md bg-white/15 px-2.5 py-1 text-xs text-white hover:bg-white/25';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.innerText.replace(/복사(됨 ✓)?$/, '').trim());
        btn.textContent = '복사됨 ✓';
        setTimeout(() => (btn.textContent = '복사'), 1500);
      } catch { /* clipboard blocked */ }
    });
    pre.appendChild(btn);
  });
</script>
