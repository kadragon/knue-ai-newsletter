---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TOOL_LABEL, TOOL_TEXT, slugOf, volLabel } from '../../lib/site';

export async function getStaticPaths() {
  const issues = await getCollection('issues');
  return issues.map((issue) => ({
    params: { tool: issue.data.tool, slug: slugOf(issue.id, issue.data.tool) },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const { Content } = await render(issue);
const { tool, vol, year, title, description, sources } = issue.data;
---
<Base title={title} description={description}>
  <p class="text-xs tracking-widest text-stone-500">
    <span class={`font-semibold ${TOOL_TEXT[tool]}`}>{TOOL_LABEL[tool]}</span> · {volLabel(vol, year)}
  </p>
  <h1 class="mt-2 text-3xl font-bold leading-snug">{title}</h1>
  <p class="mt-3 text-lg text-stone-600">{description}</p>
  <article class="prose prose-stone mt-10 max-w-none prose-headings:font-bold prose-pre:bg-stone-800 prose-pre:whitespace-pre-wrap prose-table:text-sm prose-code:before:content-none prose-code:after:content-none">
    <Content />
    <section aria-labelledby="official-sources" class="mt-10 border-t border-stone-200 pt-6">
      <h2 id="official-sources">참고한 공식 자료</h2>
      <ul class="text-sm [overflow-wrap:anywhere]">
        {sources.map((source) => <li><a href={source} target="_blank" rel="noopener noreferrer">{source}</a></li>)}
      </ul>
    </section>
  </article>
</Base>

<script>
  // Open external links in a new tab so faculty keep the guide open while following a step.
  document.querySelectorAll<HTMLAnchorElement>('article a[href^="http"]').forEach((a) => {
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
  });

  // Copy button on every instruction example so faculty can paste it straight into a project.
  document.querySelectorAll<HTMLPreElement>('article pre').forEach((pre) => {
    if (pre.closest('.not-prose')) return;
    pre.style.position = 'relative';
    pre.style.paddingTop = '3rem';
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = '복사';
    btn.className = 'absolute right-3 top-3 rounded-md bg-white/15 px-2.5 py-1 text-xs text-white hover:bg-white/25';
    const status = document.createElement('p');
    status.setAttribute('role', 'status');
    status.className = 'mt-2 text-sm text-stone-600';
    pre.after(status);
    let resetTimer: ReturnType<typeof setTimeout>;
    btn.addEventListener('click', async () => {
      clearTimeout(resetTimer);
      status.textContent = '';
      try {
        const text = pre.querySelector('code')?.textContent ?? pre.innerText.replace(/복사(됨 ✓)?$/, '');
        await navigator.clipboard.writeText(text.trim());
        btn.textContent = '복사됨 ✓';
        resetTimer = setTimeout(() => (btn.textContent = '복사'), 1500);
      } catch {
        btn.textContent = '복사';
        status.textContent = '복사하지 못했습니다. 위 예시를 직접 선택해 복사해 주세요.';
      }
    });
    pre.appendChild(btn);
  });
</script>
