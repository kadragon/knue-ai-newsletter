---
const tasks = [
  { icon: '📂', title: '내 폴더 연결', detail: '함께 볼 자료가 든 폴더를 골라 접근을 허용합니다.' },
  { icon: '🔎', title: '폴더 속 자료 읽기', detail: '원고와 참고문헌을 따로 첨부하지 않고도 두 자료를 비교할 수 있습니다.' },
  { icon: '📝', title: '같은 폴더에 저장', detail: '비교표나 요약문을 새 파일로 만들어 원고와 같은 폴더에 저장합니다.' },
];
---
<ul role="list" class="not-prose my-5 grid list-none gap-2 p-0 sm:grid-cols-3">
  {tasks.map(({ icon, title, detail }) => (
    <li class="m-0 grid grid-cols-[2rem_1fr] items-start gap-x-2 rounded-lg border border-stone-200 bg-stone-50 p-3 sm:block">
      <span aria-hidden="true" class="row-span-2 text-2xl leading-tight">{icon}</span>
      <strong class="block text-base text-stone-900 sm:mt-2">{title}</strong>
      <span class="block text-sm leading-relaxed text-stone-700">{detail}</span>
    </li>
  ))}
</ul>
