---
// verified-against: live claude.ai Settings > 사용량 (Korean UI, Team org account), 2026-10-25
// Percentages and reset times are placeholders; the per-model weekly row is omitted.
import Frame from '../Frame.astro';
import Hl from '../Hl.astro';
const icon = 'h-4 w-4 shrink-0 fill-none stroke-current stroke-[1.5]';
const nav = ['일반', '계정', '개인정보보호', '사용량', '기능', '메모리'];
const track = 'h-2 flex-1 overflow-hidden rounded-full';
---
<Frame tone="claude" caption="설정 → 사용량: ① 현재 세션(5시간 주기) ② 주간 한도">
  <div class="bg-[#1f1e1d]/20 p-5 text-black/90">
    <div class="mx-auto overflow-hidden rounded-xl border border-black/10 bg-white shadow-lg">
      <div class="flex items-center justify-between border-b border-black/[0.08] px-4 py-2.5">
        <p class="text-[13px] font-medium">설정</p>
        <span class="text-black/50">✕</span>
      </div>
      <div class="flex">
        <aside class="w-36 shrink-0 space-y-0.5 border-r border-black/[0.08] p-2 text-[13px]">
          <p class="mb-1.5 flex items-center gap-2 rounded-lg border border-black/10 px-2 py-1 text-black/45">
            <svg viewBox="0 0 16 16" class={icon}><circle cx="7" cy="7" r="4.5" /><path d="m10.5 10.5 3 3" /></svg>검색
          </p>
          <p class="px-2 pb-0.5 pt-1 text-[11px] text-black/45">환경설정</p>
          {nav.map((n) => (
            <p class={`rounded-lg px-2 py-1 ${n === '사용량' ? 'bg-black/[0.06] font-medium' : 'text-black/70'}`}>{n}</p>
          ))}
        </aside>
        <div class="flex-1 px-5 py-4">
          <p class="font-semibold">사용 한도 <span class="ml-1 font-normal text-black/50">팀</span></p>
          <Hl n={1} class="mt-3 py-1">
            <div class="flex items-center gap-4">
              <div class="w-32 shrink-0">
                <p>현재 세션</p>
                <p class="mt-0.5 text-xs text-black/55">3시간 12분 후 초기화</p>
              </div>
              <div class={`${track} bg-[#257de0]/[0.12]`}><div class="h-full w-[24%] rounded-full bg-[#257de0]"></div></div>
              <p class="w-16 shrink-0 text-right text-xs text-black/60">24% 사용됨</p>
            </div>
          </Hl>
          <p class="mt-5 font-semibold">주간 한도</p>
          <p class="mt-2 text-xs text-[#2563c9] underline underline-offset-2">사용량 제한에 대해 더 알아보기</p>
          <Hl n={2} class="mt-3 py-1">
            <div class="flex items-center gap-4">
              <div class="w-32 shrink-0">
                <p>모든 모델</p>
                <p class="mt-0.5 text-xs text-black/55">(수) 오후 2:00에 초기화</p>
              </div>
              <div class={`${track} bg-[#257de0]/[0.12]`}><div class="h-full w-[37%] rounded-full bg-[#257de0]"></div></div>
              <p class="w-16 shrink-0 text-right text-xs text-black/60">37% 사용됨</p>
            </div>
          </Hl>
          <p class="mt-5 text-xs text-black/50">마지막 업데이트: 방금 전 ↻</p>
        </div>
      </div>
    </div>
  </div>
</Frame>
