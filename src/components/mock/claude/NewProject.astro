---
// verified-against: live claude.ai projects page + "새 프로젝트" dialog (Korean UI, org account), 2026-10-19
import Frame from '../Frame.astro';
import Hl from '../Hl.astro';
import Sidebar from './Sidebar.astro';
const primary = 'block rounded-lg bg-[#141413] px-3 py-1.5 text-[13px] font-medium text-white';
---
<Frame tone="claude" caption="① 사이드바 프로젝트 → ② 새 프로젝트">
  <div class="flex h-64 text-[#141413]">
    <Sidebar highlight="projects" />
    <div class="flex-1 bg-[#faf9f5] px-6 py-5">
      <p class="font-serif text-2xl font-medium">프로젝트</p>
      <div class="mt-3 flex items-center justify-between">
        <div class="flex gap-1 text-[13px] font-medium">
          <span class="rounded-lg bg-[#1f1e1d]/[0.07] px-2.5 py-1">내 프로젝트</span>
          <span class="px-2.5 py-1 text-[#73726c]">공유받음</span>
        </div>
        <Hl n={2} class="inline-block"><span class={primary}>새 프로젝트</span></Hl>
      </div>
      <div class="mt-4 w-64 rounded-xl border border-[#1f1e1d]/15 bg-white p-3">
        <p class="font-medium">연구 노트</p>
        <p class="mt-1 text-xs text-[#3d3d3a]">학회 발표 준비용 자료 모음</p>
        <p class="mt-3 text-xs text-[#73726c]">2일 전</p>
      </div>
    </div>
  </div>
</Frame>
<Frame tone="claude" caption="③ 이름 입력 → ④ 프로젝트 생성 (설명은 Claude가 읽지 않으니 메모용으로만)">
  <div class="bg-[#1f1e1d]/20 p-6 text-[#141413]">
    <div class="mx-auto max-w-md rounded-xl border border-[#1f1e1d]/15 bg-white p-5 shadow-lg">
      <div class="flex items-center justify-between">
        <p class="text-xl font-semibold">프로젝트 생성</p>
        <span class="text-[#73726c]">✕</span>
      </div>
      <p class="mt-3 font-medium">무엇을 작업 중이신가요?</p>
      <Hl n={3} type class="mt-1.5"><p class="rounded-lg border border-[#1f1e1d]/20 bg-white px-3 py-1.5">2026-2 교육평가</p></Hl>
      <p class="mt-4 font-medium">어떤 목표를 달성하려고 하시나요?</p>
      <p class="mt-1.5 h-14 rounded-lg border border-[#1f1e1d]/20 bg-white px-3 py-2">3학년 과제 피드백용</p>
      <p class="mt-4 font-medium">컨텍스트 <span class="text-xs font-normal text-[#73726c]">선택 사항</span></p>
      <span class="mt-1.5 inline-block rounded-lg bg-[#1f1e1d]/[0.07] px-2.5 py-1">＋ 컨텍스트 추가</span>
      <div class="mt-4 flex justify-end gap-2">
        <span class="rounded-lg bg-[#1f1e1d]/[0.07] px-3 py-1.5">취소</span>
        <Hl n={4} class="inline-block"><span class={primary}>프로젝트 생성</span></Hl>
      </div>
    </div>
  </div>
</Frame>
