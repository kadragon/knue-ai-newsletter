---
/** Simplified UI illustration. Always labeled so readers don't mistake it for a real screenshot. */
interface Props { caption: string; tone?: 'chatgpt' | 'claude' }
const { caption, tone = 'chatgpt' } = Astro.props;
const bg = tone === 'claude' ? 'bg-[#f6f4ee]' : 'bg-white';
---
<figure class="not-prose my-6">
  <div class="overflow-x-auto rounded-xl border border-stone-300 shadow-sm">
    <div class="flex items-center gap-1.5 border-b border-stone-200 bg-stone-100 px-3 py-2">
      <span class="h-2.5 w-2.5 rounded-full bg-stone-300"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-stone-300"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-stone-300"></span>
    </div>
    <div class={`min-w-[560px] text-[13px] leading-snug text-stone-800 ${bg}`}><slot /></div>
  </div>
  <figcaption class="mt-2 text-xs text-stone-500">{caption} <span class="text-stone-400">· 실제 화면을 단순화한 그림입니다</span></figcaption>
</figure>
