---
// verified-against: live chatgpt.com (Korean UI, workspace account, dark theme; drawn in light) via Chrome, 2026-10-19
/** ChatGPT-style sidebar panel. `highlight` marks which item to call out. */
import Hl from '../Hl.astro';
import Icon from './Icon.astro';
interface Props { highlight?: 'new-project' | 'move-chat'; project?: string }
const { highlight, project } = Astro.props;
const row = 'flex items-center gap-2 rounded-lg px-2 py-1.5';
---
<aside class="w-52 shrink-0 border-r border-[#e5e5e5] bg-[#f9f9f9] p-2 text-[#0d0d0d]">
  <div class="flex items-center justify-between px-2 py-1.5">
    <span class="text-[15px] font-medium">ChatGPT</span>
    <span class="flex gap-2 text-[#5d5d5d]"><Icon name="search" /><Icon name="panel" /></span>
  </div>
  <p class={row}><Icon name="edit" /> 새 채팅</p>
  <div class="mt-3 flex items-center justify-between px-2 py-1 text-[#8f8f8f]">
    <span class="flex items-center gap-1">프로젝트 <Icon name="chevron" class="h-3 w-3" /></span>
    <span class="flex items-center gap-1.5 text-[#5d5d5d]">
      <Icon name="dots" />
      {highlight === 'new-project'
        ? <Hl n={1} label="＋ (새 프로젝트 추가)" class="inline-block !rounded"><span class="block rounded bg-[#ececec]"><Icon name="plus" /></span></Hl>
        : <Icon name="plus" />}
    </span>
  </div>
  {project && <p class={row}><Icon name="folder" /> {project}</p>}
  <p class={row}><Icon name="folder" /> 연구 노트</p>
  <p class="mt-3 flex items-center gap-1 px-2 py-1 text-[#8f8f8f]">최근 <Icon name="chevron" class="h-3 w-3" /></p>
  {highlight === 'move-chat'
    ? <p class={`${row} justify-between bg-[#ececec]`}><span>루브릭 초안 검토</span><Hl n={1} label="⋯ (채팅 메뉴)" class="inline-block"><span class="block text-[#5d5d5d]"><Icon name="dots" /></span></Hl></p>
    : <p class={row}>루브릭 초안 검토</p>}
  <p class={row}>학회 발표 요약</p>
  <p class={row}>회의록 정리</p>
</aside>
