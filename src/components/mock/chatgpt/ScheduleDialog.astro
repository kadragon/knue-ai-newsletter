---
// verified-against: live chatgpt.com 작업 예약 dialog (Korean UI, workspace account, Work mode) via Chrome, 2026-10-25
// Opened from 예약 → 새 작업 and closed with 취소; nothing was saved. 모델/추론 수준 rows under 고급 are omitted.
import Frame from '../Frame.astro';
import Hl from '../Hl.astro';
import Icon from './Icon.astro';
import ScheduledPanel from './ScheduledPanel.astro';
const line = 'flex items-center justify-between px-3 py-2';
const toggle = (on: boolean) => `relative block h-4 w-7 rounded-full ${on ? 'bg-[#3a83f7]' : 'bg-[#d9d9d9]'}`;
---
<Frame caption="① 예약 → ② 새 작업 → ③ 지침 → ④ 반복: 평일 → ⑤ 시간 → ⑥ 새 채팅에서 시작 켜기 → ⑦ 만들기">
  <div class="relative flex h-[27rem] bg-[#fcfcfc] text-[#0d0d0d]">
    <ScheduledPanel railN={1} newN={2} />
    <div class="flex flex-1 items-center justify-center bg-black/20 p-3">
      <div class="w-full max-w-[360px] rounded-3xl bg-white p-4 shadow-xl">
        <div class="flex items-center justify-between">
          <p class="text-[15px] font-medium">작업 예약</p>
          <Icon name="close" class="h-4 w-4 text-[#5d5d5d]" />
        </div>
        <Hl n={3} type class="mt-3">
          <p class="h-12 rounded-xl border border-[#e5e5e5] px-3 py-2 text-[12px]">오늘 날짜와 요일을 한 줄로 알려 줘.</p>
        </Hl>
        <div class="mt-2.5 divide-y divide-[#ececec] rounded-xl border border-[#e5e5e5] text-[12px]">
          <p class={line}>작업 반복 <span class={toggle(true)}><span class="absolute right-0.5 top-0.5 h-3 w-3 rounded-full bg-white"></span></span></p>
          <p class={line}>반복 <Hl n={4} class="inline-block"><span class="flex items-center gap-1 px-1 text-[#5d5d5d]">평일 <Icon name="chevron" class="h-3 w-3" /></span></Hl></p>
          <p class={line}>시간 <Hl n={5} class="inline-block"><span class="flex items-center gap-1 px-1 text-[#5d5d5d]">오전 6:00 <Icon name="chevron" class="h-3 w-3" /></span></Hl></p>
          <p class={line}>반복 종료 <span class="flex items-center gap-1 text-[#5d5d5d]">종료 안 함 <Icon name="chevron" class="h-3 w-3" /></span></p>
        </div>
        <p class="mt-2 flex items-center gap-1 px-1 text-[12px]">고급 <Icon name="chevron" class="h-3 w-3 rotate-180" /></p>
        <p class={`${line} mt-1.5 rounded-xl border border-[#e5e5e5] text-[12px]`}>시간대 <span class="flex items-center gap-1 text-[#5d5d5d]">한국 표준시 <Icon name="chevron" class="h-3 w-3" /></span></p>
        <Hl n={6} label="실행할 때마다 새 채팅에서 시작 (켜기)" class="mt-1.5">
          <p class={`${line} rounded-xl border border-[#e5e5e5] text-[12px]`}>실행할 때마다 새 채팅에서 시작 <span class={toggle(true)}><span class="absolute right-0.5 top-0.5 h-3 w-3 rounded-full bg-white"></span></span></p>
        </Hl>
        <div class="mt-3 flex justify-end gap-2 text-[12px]">
          <span class="rounded-full bg-[#f3f3f3] px-3 py-1.5">취소</span>
          <Hl n={7} class="inline-block !rounded-full"><span class="block rounded-full bg-[#0d0d0d] px-3 py-1.5 font-medium text-white">만들기</span></Hl>
        </div>
      </div>
    </div>
  </div>
</Frame>
