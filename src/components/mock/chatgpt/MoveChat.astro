---
// verified-against: live chatgpt.com (Korean UI, workspace account) via Chrome, 2026-10-19
// The "프로젝트로 이동" submenu contents were not opened; its project list is illustrative.
import Frame from '../Frame.astro';
import Hl from '../Hl.astro';
import Icon from './Icon.astro';
import Sidebar from './Sidebar.astro';
---
<Frame caption="① 채팅 옆 ⋯ → ② 프로젝트로 이동 → ③ 옮길 프로젝트 선택">
  <div class="relative flex h-[25rem] text-[#0d0d0d]">
    <Sidebar highlight="move-chat" project="2026-2 교육평가" />
    <div class="flex-1"></div>
    <div class="absolute left-44 top-[15.5rem] w-36 rounded-2xl border border-[#e5e5e5] bg-white p-1.5 shadow-lg">
      <p class="flex items-center gap-2 px-2 py-1"><Icon name="edit" class="h-3.5 w-3.5" />이름 변경</p>
      <p class="flex items-center gap-2 px-2 py-1"><Icon name="share" class="h-3.5 w-3.5" />공유</p>
      <p class="px-2 py-1 text-[#8f8f8f]">…</p>
      <Hl n={2}><p class="flex items-center justify-between rounded-lg bg-[#f3f3f3] px-2 py-1"><span class="flex items-center gap-2"><Icon name="folder" class="h-3.5 w-3.5" />프로젝트로 이동</span>›</p></Hl>
    </div>
    <div class="absolute left-[20.5rem] top-[19rem] w-40 rounded-2xl border border-[#e5e5e5] bg-white p-1.5 shadow-lg">
      <Hl n={3}><p class="flex items-center gap-2 rounded-lg bg-[#f3f3f3] px-2 py-1"><Icon name="folder" class="h-3.5 w-3.5" />2026-2 교육평가</p></Hl>
      <p class="mt-1 flex items-center gap-2 px-2 py-1"><Icon name="folder" class="h-3.5 w-3.5" />연구 노트</p>
    </div>
  </div>
</Frame>
