---
/** Inline numbered marker matching the badges in Hl, for use in step text. */
interface Props { n: number }
const { n } = Astro.props;
---
<span class="not-prose mx-0.5 inline-flex h-5 w-5 items-center justify-center rounded-full bg-amber-500 align-[-3px] text-[11px] font-bold text-white">{n}</span>
